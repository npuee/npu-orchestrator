# ==============================================================================
# NPU Orchestrator Appliance - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your environment's secrets:
#   cp .env.example .env
#
# Validate your configuration at any time by running:
#   ./check-config.sh
# ==============================================================================

# Application Configuration
APP_ENV=production
DEBUG=false
PORT=8090
HOST=0.0.0.0

# Internal API Protection Key (Generate with: openssl rand -hex 24)
API_KEY=npu_sec_replace_with_your_secure_api_key
# AUTH_DEV_BYPASS=false  # Developer only: bypasses API key and webhook HMAC checks (never enable in prod)

# Proxmox VE API Authentication
# Create an API token in Proxmox: Datacenter -> Permissions -> API Tokens
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=orchestrator
PROXMOX_TOKEN_VALUE=your-proxmox-api-token-uuid
PROXMOX_VERIFY_SSL=false
PROXMOX_DEFAULT_NODE=pve
PROXMOX_DEFAULT_STORAGE=local-zfs

# NetBox Integration
# Create a NetBox API Token under User Profile -> API Tokens
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=your-netbox-api-token

# NetBox Webhook Security (HMAC-SHA512 Verification)
# Generate with: openssl rand -hex 32
NETBOX_WEBHOOK_SECRET=your-webhook-hmac-secret-hex
NETBOX_VERIFY_SSL=true

# Signal Notifications (Optional)
SIGNAL_ENABLED=false
SIGNAL_API_URL=http://signal-backend:8080/v2/send
SIGNAL_SENDER=+1234567890
SIGNAL_RECIPIENTS=["+1234567890"]

# SQLite Database Storage (Inside Docker)
SQLITE_DB_PATH=/data/orchestrator.db

# Uptime Kuma Monitoring (Optional)
UPTIME_KUMA_URL=http://172.31.0.1:3001
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=your-uptime-kuma-password
UPTIME_KUMA_VERIFY_SSL=true

# Infrastructure Fallback Defaults (Optional)
DEFAULT_DNS_DOMAIN=homelab.local
DEFAULT_DNS_SERVER=192.168.1.1
DEFAULT_GATEWAY=192.168.1.1
DEFAULT_BRIDGE=vmbr0
# DEFAULT_SSH_KEY="ssh-ed25519 AAAAC3..."

